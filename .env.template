# MariaDB Database Configuration
# ---------------------------------------------------------------------------
# TEMPLATE FILE - SAFE TO COMMIT. It must NEVER contain real credentials.
# Copy this file to .env (gitignored) and put the real values there:
#     cp .env.template .env
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ebay_api
DB_USER=replace_with_your_db_username
DB_PASSWORD=replace_with_your_db_password

# eBay API Credentials  (https://developer.ebay.com/my/auth/)
# App ID
EBAY_CLIENT_ID=replace_with_your_ebay_app_id
# Cert ID
EBAY_CLIENT_SECRET=replace_with_your_ebay_cert_id
# RuName from the Auth section of your developer account
EBAY_RUNAME=replace_with_your_ru_name
# sandbox or production
EBAY_ENV=sandbox
